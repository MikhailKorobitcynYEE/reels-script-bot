# Токен бота от @BotFather в Telegram
BOT_TOKEN=1234567890:AAA-вставьте_свой_токен

# Ключ Perplexity API (https://www.perplexity.ai/settings/api), начинается с pplx-
PPLX_API_KEY=pplx-вставьте_свой_ключ

# Модель, которая пишет сценарии.
# Варианты: anthropic/claude-sonnet-5, openai/gpt-5.6-sol, perplexity/sonar
# Полный список под ваш аккаунт: python list_models.py
MODEL=anthropic/claude-sonnet-5

# Максимальная длина ответа модели в токенах
MAX_OUTPUT_TOKENS=8000

# «Творческость» модели: 0 — строго по факту, 2 — максимум фантазии
# TEMPERATURE=0.8  (пусто — не отправлять; Anthropic-модели через этот API не принимают temperature)

# Веб-поиск: бот проверяет актуальные тренды и алгоритмы Instagram в интернете,
# а не полагается на память модели (true/false)
ENABLE_WEB_SEARCH=true

# Сколько шагов поиска может сделать модель за один сценарий
MAX_STEPS=3

# Сколько последних сообщений диалога отправлять модели (экономия токенов)
HISTORY_LIMIT=24
